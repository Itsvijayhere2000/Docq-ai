generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  ADMIN
}
enum WorkspaceRole {
  OWNER
  MEMBER
}
enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}
enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  email           String            @unique
  passwordHash    String
  platformRole    PlatformRole      @default(USER)
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  uploadedDocs    Document[]        @relation("DocumentUploader")
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model RefreshSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
}

model SignupOtp {
  id           String   @id @default(uuid()) @db.Uuid
  email        String
  name         String
  passwordHash String
  codeHash     String
  expiresAt    DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  @@index([email, expiresAt])
}

model Workspace {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  description String            @default("")
  ownerId     String            @db.Uuid
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members     WorkspaceMember[]
  documents   Document[]
  chunks      DocumentChunk[]
  conversations Conversation[]
  auditLogs   AuditLog[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  status      MemberStatus  @default(ACTIVE)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, userId])
  @@index([userId, status])
}

model Document {
  id            String         @id @default(uuid()) @db.Uuid
  workspaceId   String         @db.Uuid
  uploadedById  String         @db.Uuid
  name          String
  storageKey    String         @unique
  mimeType      String
  sizeBytes     BigInt
  pageCount     Int?
  status        DocumentStatus @default(UPLOADED)
  failureReason String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy    User           @relation("DocumentUploader", fields: [uploadedById], references: [id])
  chunks        DocumentChunk[]
  citations     Citation[]
  @@index([workspaceId, status])
  @@index([uploadedById])
}

model DocumentChunk {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @db.Uuid
  workspaceId String   @db.Uuid
  chunkIndex  Int
  pageNumber  Int
  content     String
  embedding   Unsupported("vector(768)")?
  createdAt   DateTime @default(now())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  citations   Citation[]
  @@unique([documentId, chunkIndex])
  @@index([workspaceId, documentId])
}

model Conversation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  title       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    Message[]
  @@index([workspaceId, userId, updatedAt])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  role           String
  content        String
  createdAt      DateTime    @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  citations      Citation[]
  @@index([conversationId, createdAt])
}

model Citation {
  id              String   @id @default(uuid()) @db.Uuid
  messageId       String   @db.Uuid
  documentId      String   @db.Uuid
  chunkId         String   @db.Uuid
  pageNumber      Int
  relevanceScore  Float?
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunk           DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  @@index([messageId])
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @db.Uuid
  workspaceId String?    @db.Uuid
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}
